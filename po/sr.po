#: src/help-page.vala:22
msgid ""
"The game consists of <b>guessing words</b> five characters long. You try to enter your guesses one by one, pressing Enter after each one.\n"
"\n"
"After confirmation, the cell <b>color changes</b> to indicate how close you are to the word you are looking for with your guess:"
msgstr ""
"Игра се састоји од <b>погађања речи</b> дужине пет знакова. Своје покушаје уносите један по један, притискајући Ентер након сваког.\n"
"\n"
"Након потврде, <b>боја поља се мења</b> како би указала на то колико сте близу траженој речи својим покушајем:"

#. Word cells are separated by slashes, the cell with state preview starts with exclamation mark
#: src/help-page.vala:30
msgctxt "Preview of the word cells"
msgid "!w/e/a/r/y"
msgstr "!у/м/о/р/а"

#: src/help-page.vala:32
msgid "<b>W</b> is in the word and in the correct spot."
msgstr "<b>В</b> је у речи и на тачном месту."

#. Word cells are separated by slashes, the cell with state preview starts with exclamation mark
#: src/help-page.vala:36
msgctxt "Preview of the word cells"
msgid "p/!i/l/l/s"
msgstr "п/!и/л/у/л"

#: src/help-page.vala:38
msgid "<b>I</b> is in the word but in the wrong spot."
msgstr "<b>И</b> је у речи али на погрешном месту."

#. Word cells are separated by slashes, the cell with state preview starts with exclamation mark
#: src/help-page.vala:42
msgctxt "Preview of the word cells"
msgid "v/a/g/!u/e"
msgstr "м/а/г/!л/а"

#: src/help-page.vala:44
msgid "<b>U</b> is not in the word in any spot."
msgstr "<b>У</b> није у речи ни на једном месту."

#.
#. A key is represented by braces, which contain displayed string, slash
#. the string to add to cell.
#.
#. {a/a}
#.
#. There are also two special keys:
#.
#. {enter}, {backspace}
#.
#. You can also specify the size of the key by adding the size
#. information:
#.
#. {a/a/1}, {enter/2}, {backspace/3}
#.
#. Keys are divided by commas, lines by semicolons.
#.
#. {q/q}, {w/w}, {e/e}, {r/r}, {t/t}, {y/y}, {u/u}, {i/i}, {o/o}, {p/p};
#. {a/a}, {s/s}, {d/d}, {f/f}, {g/g}, {h/h}, {j/j}, {k/k}, {l/l};
#. {enter}, {z/z}, {x/x}, {c/c}, {v/v}, {b/b}, {n/n}, {m/m}, {backspace}
#.
#: src/data.vala:42
msgctxt "Game keyboard"
msgid "data-keyboard"
msgstr "{љ/љ}, {њ/њ}, {е/е}, {р/р}, {т/т}, {з/з}, {у/у}, {и/и}, {о/о}, {п/п}, {ш/ш}, {ђ/ђ}; {а/а}, {с/с}, {д/д}, {ф/ф}, {г/г}, {х/х}, {ј/ј}, {к/к}, {л/л}, {ч/ч}, {ћ/ћ}, {ж/ж}; {enter/2}, {ц/ц}, {в/в}, {б/б}, {н/н}, {м/м}, {backspace/2}"

#.
#. Each replacement on its own line. Original and its replacement divide
#. with slash.
#.
#. á/a
#. č/c
#. …
#.
#: src/data.vala:61
msgctxt "Replaced letters"
msgid "data-replacements"
msgstr "ш/ш"

#.
#. Letters to be read from the keyboard.
#.
#. a/b/c/d/e/f/g/h/i/j/k/l/m/n/o/p/q/r/s/t/u/v/w/x/y/z
#.
#: src/data.vala:72
msgctxt "Available letters"
msgid "data-letters"
msgstr "а/б/в/г/д/ђ/е/ж/з/и/ј/к/л/љ/м/н/њ/о/п/р/с/т/ћ/у/ф/х/ц/ч/џ/ш"

#.
#. All words have to be 5 letters long. Each word on its own line.
#. Individual characters please divide with slash. The reason for this
#. is that some letters are in unicode made of two characters.
#.
#. a/a/h/e/d
#. a/a/l/i/i
#. a/a/r/g/h
#. …
#.
